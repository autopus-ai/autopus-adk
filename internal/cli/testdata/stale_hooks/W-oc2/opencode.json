{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/rules/autopus/branding.md",
    ".opencode/rules/autopus/deferred-tools.md",
    ".opencode/rules/autopus/file-size-limit.md",
    ".opencode/rules/autopus/language-policy.md",
    ".opencode/rules/autopus/lore-commit.md",
    ".opencode/rules/autopus/objective-reasoning.md",
    ".opencode/rules/autopus/project-identity.md",
    ".opencode/rules/autopus/shell-portability.md",
    ".opencode/rules/autopus/subagent-delegation.md",
    ".opencode/rules/autopus/worktree-safety.md"
  ],
  "plugins": [
    "./.opencode/plugins/autopus-hooks.js",
    {
      "package": "file://{{ROOT}}/.claude/hooks/autopus/hook-opencode-complete.ts",
      "options": {}
    },
    {
      "package": "my-plugin"
    },
    "./plugins/mine.ts"
  ]
}
