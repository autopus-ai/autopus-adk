;; Oracle profile for the SPEC-HARNEVAL-003 signed live lane (REQ-HR-08).
;;
;; golden_blackbox.py starts the trusted oracle harness, built from the runner
;; checkout (cmd/harneval-oracle), as a sibling process, never nested, and only
;; after the artifact and every process it left have ended:
;;   env -i <allowlist> sandbox-exec -f oracle.sb -D ORACLE=<harness binary>
;;     -D OUTPUT_ROOT=<artifact output root> -D RESULT_DIR=<result directory>
;;     -D CHECKOUT=<runner checkout> -D SET_ROOT=<golden set root>
;;     -D ACCOUNT_HOME=<home> -D CODEX_HOME_DIR=<codex home>
;;     harneval-oracle --task <id> --outputs <OUTPUT_ROOT> --result <RESULT_DIR>
;; with the bundle (expected outputs, assertions, stdout, exit status) on
;; stdin. The expected outputs exist on disk only in the golden set root, which
;; this profile closes entirely, so an output link or a code defect cannot make
;; the harness compare an expected file with itself.
;;
;; Network and every Mach service lookup are denied. The only writable tree is
;; RESULT_DIR: the harness cannot change an artifact output.
(version 1)
(allow default)
(deny network*)
(deny mach-lookup)
(deny file-write*)
(allow file-write*
  (subpath (param "RESULT_DIR"))
  (literal "/dev/null"))

;; Reads are an allowlist, as in artifact.sb: metadata and existence tests stay
;; open for path resolution except below the runner checkout, the golden set
;; root, the Codex home and the keychains; file contents are readable only on
;; the system paths a process needs to start, the harness binary, the artifact
;; output root and the result directory.
(deny file-read* file-test-existence)
(allow file-read-metadata file-test-existence)
(deny file-read-metadata file-test-existence
  (subpath (param "CHECKOUT"))
  (subpath (param "SET_ROOT"))
  (subpath (param "CODEX_HOME_DIR"))
  (subpath (string-append (param "ACCOUNT_HOME") "/Library/Keychains"))
  (subpath "/Library/Keychains"))
(allow file-read-data file-read-xattr file-read-metadata file-test-existence
  (literal "/")
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/private/var/db/dyld")
  (subpath "/dev")
  (literal (param "ORACLE"))
  (subpath (param "OUTPUT_ROOT"))
  (subpath (param "RESULT_DIR")))

;; Other processes stay closed (SPEC-HARNEVAL-003 S1). A same-user sibling's
;; environment, which on the live runner holds the agent credential, is
;; readable through the kern.procargs2 sysctl, and its state through
;; proc_info and the kern.proc sysctls; a signal could stop or kill it. So
;; proc_info and signals reach this process only, and sysctl reads are the
;; hardware, kernel-version and clock names a Go program, the go command and
;; a test binary read (the App Sandbox container profile's list, without any
;; kern.proc or kern.procargs name).
(deny process-info*)
(allow process-info* (target self))
(deny signal)
(allow signal (target self))
(deny sysctl-read)
(allow sysctl-read
  (sysctl-name
    "hw.activecpu" "hw.busfrequency" "hw.busfrequency_compat" "hw.byteorder" "hw.cacheconfig"
    "hw.cachelinesize" "hw.cachelinesize_compat" "hw.cachesize" "hw.cpu64bit_capable" "hw.cpufamily"
    "hw.cpufrequency" "hw.cpufrequency_compat" "hw.cpufrequency_max" "hw.cpusubfamily" "hw.cpusubtype"
    "hw.cputype" "hw.l1dcachesize" "hw.l1dcachesize_compat" "hw.l1icachesize" "hw.l1icachesize_compat"
    "hw.l2cachesize" "hw.l2cachesize_compat" "hw.l2settings" "hw.l3cachesize" "hw.l3cachesize_compat"
    "hw.l3settings" "hw.logicalcpu" "hw.logicalcpu_max" "hw.machine" "hw.memsize" "hw.model" "hw.ncpu"
    "hw.nperflevels" "hw.pagesize" "hw.pagesize_compat" "hw.physicalcpu" "hw.physicalcpu_max" "hw.physmem"
    "hw.product" "hw.target" "hw.tbfrequency" "hw.tbfrequency_compat" "hw.usermem" "hw.vectorunit"
    "machdep.virtual_address_size" "machdep.ptrauth_enabled"
    "kern.boottime" "kern.clockrate" "kern.hostname" "kern.hv_vmm_present" "kern.iossupportversion"
    "kern.maxfilesperproc" "kern.maxproc" "kern.maxvnodes" "kern.memorystatus_level"
    "kern.monotoniclock_offset_usecs" "kern.ngroups" "kern.osproductversion" "kern.osrelease"
    "kern.ostype" "kern.osvariant_status" "kern.osversion" "kern.safeboot" "kern.saved_ids"
    "kern.secure_kernel" "kern.system_version_compat" "kern.usrstack64" "kern.version" "kern.waketime"
    "security.mac.sandbox.sentinel" "vm.loadavg" "sysctl.name2oid" "sysctl.proc_native")
  (sysctl-name-prefix "hw.optional.")
  (sysctl-name-prefix "hw.perflevel")
  (sysctl-name-prefix "kern.monotonicclock")
  (sysctl-name-prefix "sysctl.oidfmt."))
