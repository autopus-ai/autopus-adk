package diskgate

// Pilot C oracle c03, classifier cases (hidden from the agent): the tests of
// c7f50103/32debe26 pkg/diskgate/classify_cpu_test.go and of 3b194190
// pkg/diskgate/classify_cpu_more_test.go, split into one case per command
// group, identifiers prefixed, and the normalised Match text relaxed to
// "non-empty" so a differently spelled match is not counted as a defect
// (README.md, Pilot C). Installs and checkouts (npm i, pnpm install, uv sync,
// pip install, git worktree add, yarn workspace ... add) are pinned neither
// way: the prompt calls the disk gate's heavy commands CPU-heavy, the fixed
// head treats them as light. cargo nextest list compiles the test binaries,
// so it is not pinned light either.

import (
	"testing"
)

func oc03Heavy(t *testing.T, classify func(string, ...string) Verdict, lines ...string) {
	t.Helper()
	for _, line := range lines {
		if v := classify(line); !v.Heavy || v.Match == "" {
			t.Errorf("%q: want heavy with a match, got %+v", line, v)
		}
	}
}

func oc03Light(t *testing.T, classify func(string, ...string) Verdict, lines ...string) {
	t.Helper()
	for _, line := range lines {
		if v := classify(line); v.Heavy {
			t.Errorf("%q: want not heavy, got %+v", line, v)
		}
	}
}

func TestOracleC03_TestRunnersAreCPUWork(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "go test ./...", "pnpm test", "pnpm exec vitest run", "pnpm vitest", "pytest -q",
		"uv run pytest -x", "python3 -m pytest", "cd web && CI=1 vitest run")
}

func TestOracleC03_LintersAndTypeCheckersAreCPUWork(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "go vet ./...", "cargo clippy --all", "pnpm -r lint", "pnpm --filter web typecheck",
		"npm --prefix web run lint", "npm run lint:fix", "npx eslint .", "eslint . --max-warnings=0",
		"golangci-lint run ./...", "bash -c 'pnpm -r lint'")
}

// The disk gate's compiles stay heavy for the CPU gate.
func TestOracleC03_DiskGateCompilesAreCPUWork(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "go install ./cmd/x", "npm run build:docs")
}

// A lease without --cpu reserves no CPU; one with --cpu is the way out.
func TestOracleC03_OnlyACPULeaseCoversTheCommand(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "auto disk lease --need 8 -- go test ./...")
	oc03Light(t, ClassifyCPU, "auto disk lease --cpu 4 -- go test ./...", "auto disk lease --cpu=4 --need 8 -- pnpm test")
}

func TestOracleC03_ExtraPrefixesAreCPUWork(t *testing.T) {
	if v := ClassifyCPU("make release", "make release"); !v.Heavy {
		t.Errorf("an extra prefix is CPU work too: %+v", v)
	}
}

func TestOracleC03_LookupsAndLightCommandsAreLight(t *testing.T) {
	oc03Light(t, ClassifyCPU, "auto disk status", "tsc --version", "eslint --help", "git status", "pnpm run dev",
		"heavy-lock.sh x go test")
}

// A build that compiles is CPU work, also when it is spelled as an install.
func TestOracleC03_JVMInstallsAreCPUWork(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "mvn clean install", "./mvnw -B install", "gradle install")
}

func TestOracleC03_ExtraCICommandsAreCPUWork(t *testing.T) {
	for _, extra := range []string{"make ci", "just ci"} {
		if v := ClassifyCPU(extra, extra); !v.Heavy {
			t.Errorf("an extra command ending in ci is CPU work: %q %+v", extra, v)
		}
	}
}

// A verbose flag runs the tool; only a version flag of that tool does not.
func TestOracleC03_VerboseFlagRunsTheTool(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "pytest -v", "uv run pytest -v")
}

func TestOracleC03_VersionFlagsAreLight(t *testing.T) {
	oc03Light(t, ClassifyCPU, "pytest -V", "mypy --version", "eslint -v")
}

// Options and their values in front of the tool a runner runs are skipped.
func TestOracleC03_UvRunOptionsAreSkipped(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "uv run --frozen python -m pytest", "uv run --with pytest-cov pytest",
		"uv --directory api run --python 3.12 mypy .")
}

func TestOracleC03_PoetryRunOptionsAreSkipped(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "poetry run -C api pytest")
}

func TestOracleC03_RunnerOfALightProgramIsLight(t *testing.T) {
	oc03Light(t, ClassifyCPU, "uv run --frozen python -c 'print(1)'")
}

// Shells, timers, nice and xargs run the command they are given.
func TestOracleC03_ShellOptionsBeforeTheScriptAreSeenThrough(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "bash -lc 'go test ./...'", "zsh -ec 'pnpm -r lint'")
}

func TestOracleC03_TimeIsSeenThrough(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "/usr/bin/time go test ./...")
}

func TestOracleC03_NiceIsSeenThrough(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "nice -10 go test ./...", "nice -n 5 pytest")
}

func TestOracleC03_XargsIsSeenThrough(t *testing.T) {
	oc03Heavy(t, ClassifyCPU, "find . -name '*.go' | xargs go test", "xargs -n 1 -P 4 pytest")
}

func TestOracleC03_WrappersOfLightCommandsAreLight(t *testing.T) {
	oc03Light(t, ClassifyCPU, "bash -l", "nice -10 ls", "xargs rm")
}
