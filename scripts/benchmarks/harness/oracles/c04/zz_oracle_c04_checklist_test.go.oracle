package checklist

// Pilot C oracle c04, pkg/checklist cases (hidden from the agent): the tests
// of aca0228d id_test.go and c9149d98 id_merge_test.go through the exported
// API (Propose, SaveCandidate, LoadCandidates, Refute, Approve, Reject,
// SetMode, WorkingChecks, ValidID) and the base test helpers gitRepo, writeT,
// escapeEntry, exits and testNow. Assertions on unexported functions and on
// the status report the fix added were dropped.

import (
	"context"
	"fmt"
	"os"
	"path/filepath"
	"regexp"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"

	"github.com/insajin/autopus-adk/pkg/learn"
)

var oc04CheckID = regexp.MustCompile(`^CHK-(\d{3,})-([0-9a-f]{6})$`)

func TestOracleC04_ProposeTwoBranchesFromSameBase(t *testing.T) {
	old := Check{ID: "CHK-001", Mode: ModeObserve, When: When{Paths: []string{"src/**"}}, Sources: []string{"L-001"},
		Created: "2026-11-18", Body: "old"}
	data, err := old.Format()
	require.NoError(t, err)
	branch := func(lesson learn.LearningEntry) Candidate {
		root := t.TempDir()
		writeT(t, root, filepath.Join(ChecksDir, "CHK-001.md"), string(data))
		created, _, err := Propose(root, []learn.LearningEntry{lesson}, testNow)
		require.NoError(t, err)
		require.Len(t, created, 1)
		return created[0]
	}
	a := branch(escapeEntry("L-004-aaaaaa", "A defect", "c1", exits("./a.sh", 1, 0)))
	b := branch(escapeEntry("L-004-bbbbbb", "B defect", "c2", exits("./b.sh", 1, 0)))
	assert.NotEqual(t, a.ID, b.ID)
	for _, c := range []Candidate{a, b} {
		m := oc04CheckID.FindStringSubmatch(c.ID)
		require.NotNil(t, m, c.ID)
		assert.Equal(t, "002", m[1])
		assert.Equal(t, c.Fingerprint[:6], m[2])
	}

	merged := t.TempDir()
	writeT(t, merged, filepath.Join(ChecksDir, "CHK-001.md"), string(data))
	require.NoError(t, SaveCandidate(merged, a))
	require.NoError(t, SaveCandidate(merged, b))
	cands, err := LoadCandidates(merged)
	require.NoError(t, err)
	assert.Len(t, cands, 2)
	next, _, err := Propose(merged, []learn.LearningEntry{escapeEntry("L-005-cccccc", "C defect", "c3",
		exits("./c.sh", 1, 0))}, testNow)
	require.NoError(t, err)
	require.Len(t, next, 1)
	m := oc04CheckID.FindStringSubmatch(next[0].ID)
	require.NotNil(t, m, next[0].ID)
	assert.Equal(t, "003", m[1], "the next id is above both merged candidates")
}

func TestOracleC04_CheckIDForms(t *testing.T) {
	for id, want := range map[string]bool{
		"CHK-001": true, "CHK-1000": true, "CHK-004-3fa9c1": true,
		"CHK-01": false, "CHK-004-": false, "CHK-004-3FA9C1": false, "CHK-004-3fa9c1.json": false, "../CHK-001": false,
	} {
		assert.Equal(t, want, ValidID(id), id)
	}
}

func TestOracleC04_DecisionsTakeOldAndNewIDs(t *testing.T) {
	root, _ := gitRepo(t)
	survived := func(context.Context, string, string) (string, error) {
		return "VERDICT: survived\nREASON: specific", nil
	}
	for i, id := range []string{"CHK-001", "CHK-002-0a1b2c", "CHK-003", "CHK-004-abcdef"} {
		c := Candidate{ID: id, State: StatePendingRefutation, Fingerprint: fmt.Sprintf("%012d", i), DraftedBy: "claude",
			Created: testNow, Lessons: []string{"L-001"},
			Check: Check{ID: id, Mode: ModeObserve, When: When{Paths: []string{"src/**"}}, Sources: []string{"L-001"},
				Created: "2026-11-18", Body: "b"}}
		require.NoError(t, SaveCandidate(root, c))
		got, err := Refute(context.Background(), root, c, []string{"claude", "codex"}, survived, testNow)
		require.NoError(t, err, id)
		require.Equal(t, StateAwaitingApproval, got.State, id)
	}
	for _, id := range []string{"CHK-001", "CHK-002-0a1b2c"} {
		_, err := Approve(root, id, testNow)
		require.NoError(t, err, id)
		_, err = os.Stat(filepath.Join(root, ChecksDir, id+".md"))
		require.NoError(t, err, id)
	}
	for _, id := range []string{"CHK-003", "CHK-004-abcdef"} {
		require.NoError(t, Reject(root, id, testNow), id)
	}
	_, err := Approve(root, "CHK-002-0A1B2C", testNow)
	assert.Error(t, err)
	checks, invalid, err := WorkingChecks(root)
	require.NoError(t, err)
	assert.Empty(t, invalid)
	require.Len(t, checks, 2)
	_, err = SetMode(root, "CHK-002-0a1b2c", ModeEnforce)
	require.NoError(t, err)
}

func oc04Draft(t *testing.T, lessons ...learn.LearningEntry) []Candidate {
	t.Helper()
	created, _, err := Propose(t.TempDir(), lessons, testNow)
	require.NoError(t, err)
	return created
}

// The same defect drafted at the same sequence on two branches gets one id,
// so the merge meets it as one file.
func TestOracleC04_SameDefectSameSequenceSameID(t *testing.T) {
	y1 := escapeEntry("L-004-aaaaaa", "Defect Y repeated", "c1", nil)
	a := oc04Draft(t, y1, escapeEntry("L-005-aaaaab", "Defect Y repeated", "c2", nil))
	b := oc04Draft(t, y1, escapeEntry("L-005-bbbbbb", "Defect Y repeated", "c3", nil))
	require.Len(t, a, 1)
	require.Len(t, b, 1)
	assert.Equal(t, a[0].ID, b[0].ID)
}

// The same defect drafted at different sequences on two branches survives a
// merge as two candidates; drafting again from the merged tree adds none.
func TestOracleC04_MergedDuplicateIsNotDraftedAgain(t *testing.T) {
	y1 := escapeEntry("L-004-aaaaaa", "Defect Y repeated", "c1", nil)
	y2 := escapeEntry("L-005-aaaaab", "Defect Y repeated", "c2", nil)
	x := escapeEntry("L-006-cccccc", "Defect X reproduced", "c9", exits("./x.sh", 1, 0))
	lessons := []learn.LearningEntry{x, y1, y2}
	a := oc04Draft(t, x, y1, y2)
	b := oc04Draft(t, y1, y2)
	require.Len(t, a, 2)
	require.Len(t, b, 1)
	merged := t.TempDir()
	for _, c := range append(append([]Candidate{}, a...), b...) {
		require.NoError(t, SaveCandidate(merged, c))
	}
	cands, err := LoadCandidates(merged)
	require.NoError(t, err)
	require.Len(t, cands, 3)
	again, _, err := Propose(merged, lessons, testNow)
	require.NoError(t, err)
	assert.Empty(t, again, "a duplicated defect is not drafted a third time")
}
