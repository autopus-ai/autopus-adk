package cli

// Pilot C oracle c01, review cases (hidden from the agent): the tests of
// 10220e08 internal/cli/ci_report_lintsrc_edge_test.go with identifiers
// prefixed and two note-text assertions relaxed to behaviour, so that a
// differently worded note is not counted as a defect (README.md, Pilot C).

import (
	"os"
	"path/filepath"
	"strings"
	"testing"
	"time"

	"github.com/insajin/autopus-adk/pkg/cireport"
)

// A feature branch whose own commits leave the workflows alone is still only
// behind as far as the workflows go, including a squash-merged branch whose
// commits never become ancestors of the default branch.
func TestOracleC01_UnrelatedLocalCommitStillLintsRemote(t *testing.T) {
	clone, _ := oc01StaleCheckout(t)
	if err := os.WriteFile(filepath.Join(clone, "README.md"), []byte("docs\n"), 0o644); err != nil {
		t.Fatal(err)
	}
	oc01Git(t, clone, "add", "README.md")
	oc01Git(t, clone, "commit", "-qm", "docs only")
	var r cireport.Report
	oc01AssertLintedRemote(t, lintCheckout(&r, "", clone, "o/r", "o/r", nil), r.Notes)
}

// The command is documented as read-only: a stale stat cache must not make
// it rewrite .git/index, which would hold the index lock against a
// concurrent commit.
func TestOracleC01_LeavesTheIndexAlone(t *testing.T) {
	clone, _ := oc01StaleCheckout(t)
	wf := filepath.Join(clone, ".github", "workflows", "ci.yml")
	if err := os.Chtimes(wf, oc01TimeAgo(), oc01TimeAgo()); err != nil {
		t.Fatal(err)
	}
	index := filepath.Join(clone, ".git", "index")
	before, err := os.Stat(index)
	if err != nil {
		t.Fatal(err)
	}
	var r cireport.Report
	lintCheckout(&r, "", clone, "o/r", "o/r", nil)
	after, err := os.Stat(index)
	if err != nil {
		t.Fatal(err)
	}
	if !os.SameFile(before, after) || !before.ModTime().Equal(after.ModTime()) {
		t.Fatalf("the lint rewrote .git/index")
	}
}

// A checkout of another repository than the one measured is never compared
// with its own remote; the note says whose files were read.
func TestOracleC01_OtherRepositoryReadsLocalWithNote(t *testing.T) {
	clone, _ := oc01StaleCheckout(t)
	var r cireport.Report
	got := lintCheckout(&r, "", clone, "o/other", "o/r", nil)
	if !strings.Contains(oc01LintIDs(got), "concurrency-cancels-other-events") {
		t.Fatalf("local checkout not linted: %v", oc01LintIDs(got))
	}
	notes := strings.Join(r.Notes, "\n")
	if !strings.Contains(notes, "local checkout of o/other, not o/r") || strings.Contains(notes, "behind") {
		t.Fatalf("notes = %q", r.Notes)
	}
}

func TestOracleC01_RemoteNotNamedOriginIsNoted(t *testing.T) {
	clone, _ := oc01StaleCheckout(t)
	oc01Git(t, clone, "remote", "rename", "origin", "upstream")
	var r cireport.Report
	lintCheckout(&r, "", clone, "", "o/r", nil)
	// Relaxed from the phrase "no remote named origin": the note must say the
	// comparison involved origin, and must not advise commands that need a
	// remote named origin to exist.
	notes := strings.Join(r.Notes, "\n")
	if !strings.Contains(notes, "origin") || strings.Contains(notes, "fetch origin") ||
		strings.Contains(notes, "set-head origin") {
		t.Fatalf("notes = %q", r.Notes)
	}
}

func TestOracleC01_NoRemoteAtAllHasNoComparisonNote(t *testing.T) {
	clone, _ := oc01StaleCheckout(t)
	oc01Git(t, clone, "remote", "remove", "origin")
	var r cireport.Report
	lintCheckout(&r, "", clone, "", "o/r", nil)
	if notes := strings.Join(r.Notes, "\n"); strings.Contains(notes, "origin") {
		t.Fatalf("notes = %q", r.Notes)
	}
}

func TestOracleC01_RemoteWithoutWorkflowsSkipsTheLint(t *testing.T) {
	clone, upstream := oc01StaleCheckout(t)
	oc01Git(t, upstream, "rm", "-q", ".github/workflows/ci.yml")
	oc01Git(t, upstream, "commit", "-qm", "drop ci")
	oc01Git(t, clone, "fetch", "-q", "origin")
	var r cireport.Report
	got := lintCheckout(&r, "", clone, "o/r", "o/r", nil)
	if len(got) != 0 {
		t.Fatalf("linted the stale checkout: %v", oc01LintIDs(got))
	}
	notes := strings.Join(r.Notes, "\n")
	// Relaxed from the phrase "origin/main has no workflow files": the note
	// must name the remote branch and must not report a read failure.
	if !strings.Contains(notes, "origin/main") || strings.Contains(notes, "could not be read") {
		t.Fatalf("notes = %q", r.Notes)
	}
}

func TestOracleC01_RemoteSymlinkIsNotAWorkflow(t *testing.T) {
	clone, upstream := oc01StaleCheckout(t)
	if err := os.Symlink("ci.yml", filepath.Join(upstream, ".github", "workflows", "link.yml")); err != nil {
		t.Skipf("symlinks unavailable: %v", err)
	}
	oc01Git(t, upstream, "add", ".")
	oc01Git(t, upstream, "commit", "-qm", "link")
	oc01Git(t, clone, "fetch", "-q", "origin")
	var r cireport.Report
	got := lintCheckout(&r, "", clone, "o/r", "o/r", nil)
	oc01AssertLintedRemote(t, got, r.Notes)
	for _, f := range got {
		if f.File == "link.yml" {
			t.Fatalf("symlink linted as a workflow: %+v", f)
		}
	}
}

func oc01TimeAgo() time.Time { return time.Now().Add(-time.Hour) }
