# autopus.yaml — {{.ProjectName}}
# Autopus-ADK 하네스 설정 파일
# 이 파일을 수정하여 프로젝트에 맞게 커스터마이징하세요.
# ADK is the harness/execution layer, not the owner of workspace folder identity.
# Generated/runtime harness surfaces are excluded from canonical Knowledge Hub indexing;
# human-managed .autopus/project, .autopus/specs, .autopus/vault, README.md, and docs remain admissible by policy.

mode: {{.Mode}}
project_name: {{.ProjectName}}
platforms:
{{range .Platforms}}  - {{.}}
{{end}}
architecture:
  auto_generate: {{.Architecture.AutoGenerate}}
  enforce: {{.Architecture.Enforce}}
  max_file_lines: {{.Architecture.MaxFileLines}}
{{if .Architecture.Layers}}  layers:
{{range .Architecture.Layers}}    - {{.}}
{{end}}{{end}}
lore:
  enabled: {{.Lore.Enabled}}
  auto_inject: {{.Lore.AutoInject}}
  stale_threshold_days: {{.Lore.StaleThresholdDays}}
{{if .Lore.RequiredTrailers}}  required_trailers:
{{range .Lore.RequiredTrailers}}    - {{.}}
{{end}}{{end}}
spec:
  id_format: "{{.Spec.IDFormat}}"
{{if .Spec.EARSTypes}}  ears_types:
{{range .Spec.EARSTypes}}    - {{.}}
{{end}}{{end}}
{{if .IsFullMode}}
methodology:
  mode: {{.Methodology.Mode}}
  enforce: {{.Methodology.Enforce}}
  review_gate: {{.Methodology.ReviewGate}}

session:
  handoff_enabled: {{.Session.HandoffEnabled}}
  continue_file: "{{.Session.ContinueFile}}"
  max_context_tokens: {{.Session.MaxContextTokens}}
{{end}}
hooks:
  pre_commit_arch: {{.Hooks.PreCommitArch}}
  pre_commit_lore: {{.Hooks.PreCommitLore}}
  react_ci_failure: {{.Hooks.ReactCIFailure}}
  react_review: {{.Hooks.ReactReview}}
{{if .IsFullMode}}
orchestra:
  enabled: {{.Orchestra.Enabled}}
  default_strategy: {{.Orchestra.DefaultStrategy}}
  timeout_seconds: {{.Orchestra.TimeoutSeconds}}
{{if .Orchestra.Providers}}  providers:
{{range $k, $v := .Orchestra.Providers}}    {{$k}}:
      binary: {{$v.Binary}}
{{if $v.Args}}      args: [{{range $i, $a := $v.Args}}{{if $i}}, {{end}}"{{$a}}"{{end}}]
{{end}}{{if $v.ModelPolicy}}      model_policy: {{$v.ModelPolicy}}
{{end}}{{if $v.PaneArgs}}      pane_args: [{{range $i, $a := $v.PaneArgs}}{{if $i}}, {{end}}"{{$a}}"{{end}}]
{{end}}{{if $v.PromptViaArgs}}      prompt_via_args: {{$v.PromptViaArgs}}
{{end}}{{if $v.InteractiveInput}}      interactive_input: {{$v.InteractiveInput}}
{{end}}{{if or $v.Subprocess.SchemaFlag $v.Subprocess.StdinMode $v.Subprocess.OutputFormat $v.Subprocess.Timeout}}      subprocess:
{{if $v.Subprocess.SchemaFlag}}        schema_flag: "{{$v.Subprocess.SchemaFlag}}"
{{end}}{{if $v.Subprocess.StdinMode}}        stdin_mode: {{$v.Subprocess.StdinMode}}
{{end}}{{if $v.Subprocess.OutputFormat}}        output_format: {{$v.Subprocess.OutputFormat}}
{{end}}{{if $v.Subprocess.Timeout}}        timeout: {{$v.Subprocess.Timeout}}
{{end}}{{end}}{{end}}{{end}}{{if .Orchestra.Commands}}  commands:
{{range $k, $v := .Orchestra.Commands}}    {{$k}}:
      strategy: {{$v.Strategy}}
      providers: [{{range $i, $p := $v.Providers}}{{if $i}}, {{end}}{{$p}}{{end}}]
{{end}}{{end}}{{end}}
design:
  enabled: {{.Design.Enabled}}
{{if .Design.Paths}}  paths:
{{range .Design.Paths}}    - {{.}}
{{end}}{{end}}  max_context_lines: {{.Design.MaxContextLines}}
  inject_on_review: {{.Design.InjectOnReview}}
  inject_on_verify: {{.Design.InjectOnVerify}}
  external_imports: {{.Design.ExternalImports}}
{{if .Design.DocsProviders}}  docs_providers:
{{range .Design.DocsProviders}}    - {{.}}
{{end}}{{end}}
{{if .Design.UIFileGlobs}}  ui_globs:
{{range .Design.UIFileGlobs}}    - {{.}}
{{end}}{{end}}
