# Codex configuration (auto-generated by Autopus-ADK)
# Project: {{.ProjectName}}

{{with .CodexSupervisorModel}}model = "{{.}}"
{{end}}{{with .CodexSupervisorEffort}}model_reasoning_effort = "{{.}}"
{{end}}
model_reasoning_summary = "auto"
model_verbosity = "medium"
approval_policy = "on-request"
sandbox_mode = "workspace-write"
web_search = "cached"
project_doc_max_bytes = 262144

[features]
goals = true
hooks = true
shell_tool = true
unified_exec = true

[features.multi_agent_v2]
enabled = true

# {{.CodexAgentConcurrencyNote}}
[agents]
max_concurrent_threads_per_session = {{.CodexAgentConcurrency}}

[plugins."browser@openai-bundled"]
enabled = true

[mcp_servers.context7]
command = "npx"
args = ["-y", "--prefix=/", "@upstash/context7-mcp@4.5.1"]
