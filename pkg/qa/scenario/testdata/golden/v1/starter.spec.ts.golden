// Scenario: A first-time visitor reaches the landing page

import { test, expect } from "../../.autopus/qa/capture/autopus-capture.fixture.cjs";

const ORIGIN = "http://127.0.0.1:4173";

test.describe("first-visit @explore", () => {
  test("landing", async ({ page }) => {
    test.info().annotations.push({ type: "autopus-screen", description: "landing" });
    await page.goto(ORIGIN + "/");
    await expect(page).toHaveTitle(new RegExp("EDIT-ME"));
    await expect(page.getByRole("heading").first()).toBeVisible();
  });
});
