import { test, expect } from "../../fixture.cjs";

const ORIGIN = "http://127.0.0.1:4173";

test.describe("hostile @explore", () => {
  test("landing", async ({ page }) => {
    test.info().annotations.push({ type: "autopus-screen", description: "landing" });
    await page.goto(ORIGIN + "/");
    await expect(page.getByText(new RegExp("a\"b\\\\c`d\\$\\{e\\}\n\u003c/script\u003e")).first()).toBeVisible();
    await expect(page.getByRole("heading", { name: "\") ; process.exit(1); //" }).first()).toBeVisible();
  });
});
