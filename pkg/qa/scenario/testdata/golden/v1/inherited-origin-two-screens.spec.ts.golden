import { test, expect } from "../../.autopus/qa/capture/autopus-capture.fixture.cjs";

const ORIGIN = "https://staging.example";

test.describe("alpha @explore", () => {
  test("home", async ({ page }) => {
    test.info().annotations.push({ type: "autopus-screen", description: "home" });
    await page.goto(ORIGIN + "/");
    await expect(page.getByText(new RegExp("hello")).first()).toBeVisible();
    await expect(page).toHaveTitle(new RegExp("Home"));
  });
  test("pricing", async ({ page }) => {
    test.info().annotations.push({ type: "autopus-screen", description: "pricing" });
    await page.goto(ORIGIN + "/pricing");
    await expect(page).toHaveURL(ORIGIN + "/pricing");
    await expect(page.getByRole("row", { name: "Plan" })).toHaveCount(0);
  });
});
