{
  "schema_version": "harness_golden_task.v1",
  "id": "GT-AGENT-PIPELINE-ROLES",
  "kind": "surface",
  "category": "agent_skill_exposure",
  "intent": "The five pipeline roles are available as native agents on every agent-capable platform.",
  "outcome": "planner, executor, tester, validator, and reviewer exist on Claude, as named Codex agents, as auto-agent-* agents in both Antigravity roots, and as OpenCode subagents.",
  "variants": [],
  "assertions": [
    {
      "kind": "file_exists",
      "platform": "claude-code",
      "path": ".claude/agents/autopus/reviewer.md"
    },
    {
      "kind": "contains",
      "platform": "codex",
      "path": ".codex/agents/reviewer.toml",
      "needle": "name = \"reviewer\"\n"
    },
    {
      "kind": "contains",
      "platform": "antigravity-cli",
      "path": ".gemini/agents/autopus/reviewer.md",
      "needle": "name: auto-agent-reviewer\n"
    },
    {
      "kind": "contains",
      "platform": "antigravity-cli",
      "path": ".agents/plugins/autopus/agents/reviewer.md",
      "needle": "name: auto-agent-reviewer\n"
    },
    {
      "kind": "contains",
      "platform": "opencode",
      "path": ".opencode/agents/reviewer.md",
      "needle": "mode: subagent\n"
    }
  ],
  "provenance": {
    "kind": "manual",
    "ref": "content/agents/*.md, pkg/adapter/*/agents"
  },
  "status": {
    "state": "active",
    "reason": ""
  }
}
